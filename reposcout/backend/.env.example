# Environment Configuration for RepoScout Backend
PROJECT_NAME="RepoScout Backend API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
# Allows Chrome extension popup, localhost Vite server, and all origins during local development
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,chrome-extension://*"

# GitHub API Credentials (Optional: increases rate limit from 10 to 30 requests/minute)
GITHUB_TOKEN=your_github_token_here

# LLM Provider Configuration for Query Understanding
# Supported providers: auto, openai, gemini, ollama, fallback
LLM_PROVIDER=auto

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Caching Configuration
# Optional Redis URL for production caching (e.g. redis://localhost:6379/0).
# If empty or unavailable, seamlessly falls back to thread-safe in-memory cache.
REDIS_URL=

# Configurable Cache Expirations (TTL in seconds)
CACHE_TTL_GITHUB_SEARCH=600
CACHE_TTL_REPOSITORY=1800
CACHE_TTL_ANALYSIS=3600
CACHE_TTL_RANKING=600
CACHE_TTL_QUERY_UNDERSTAND=1800

# Performance: Two-Stage Search deep analysis candidates limit
TWO_STAGE_TOP_CANDIDATES=5
GITHUB_REQUEST_TIMEOUT=8.0
