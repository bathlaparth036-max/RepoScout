{
  "manifest_version": 3,
  "name": "RepoScout - GitHub Discovery",
  "version": "1.0.0",
  "description": "Intelligent GitHub repository discovery foundation. Search, inspect, and evaluate repositories with developer-first relevance.",
  "action": {
    "default_popup": "index.html",
    "default_title": "RepoScout Discovery",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

